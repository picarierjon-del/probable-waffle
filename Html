    <!doctype html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#101827"><title>Controllo Consegne Smart V5</title>
    <style>
    :root{--bg:#0b1220;--panel:#152137;--field:#0d1728;--line:#30415c;--txt:#f3f6fb;--muted:#a5b2c5;--green:#20b978;--greenbg:#103b30;--red:#ff6572;--redbg:#421f2a;--blue:#80adff;--amber:#ffcb68}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--txt);font:14px system-ui,-apple-system,Segoe UI,sans-serif}header,main{max-width:1250px;margin:auto;padding:14px 10px}h1{font-size:22px;margin:0 0 4px}p,.hint{color:var(--muted);font-size:12px;margin:7px 0}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px;margin-bottom:12px}.toolbar{display:flex;gap:8px;align-items:center;justify-content:space-between;flex-wrap:wrap}button{border:0;border-radius:9px;padding:10px 13px;background:var(--blue);color:#0b1830;font-weight:700;cursor:pointer}button.secondary{background:#263751;color:var(--txt);border:1px solid var(--line)}input,select{background:var(--field);border:1px solid var(--line);color:var(--txt);border-radius:7px;padding:7px;min-width:0;font:12px system-ui}.names{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:9px}.namebox{display:flex;gap:7px;align-items:center;background:var(--field);border:1px solid var(--line);padding:7px;border-radius:8px}.namebox b{color:var(--muted)}.namebox input{width:100%}.tablewrap{overflow:auto;margin-top:9px;max-height:68vh;border:1px solid var(--line);border-radius:9px}table{border-collapse:separate;border-spacing:2px;table-layout:fixed;min-width:1950px;width:100%}th{position:sticky;top:0;z-index:2;background:#1c2a42;color:var(--muted);font-size:11px;padding:7px 3px}th:first-child,td.idx{position:sticky;left:0;z-index:1;background:#1c2a42;width:36px}th:nth-child(2),th:nth-child(3){width:85px}th.subjectHead{min-width:185px}td{padding:2px;text-align:center;background:var(--field)}td.idx{color:var(--muted)}.refInput,.cellInput{width:100%;height:30px;text-align:center}.subjectCell{display:grid;grid-template-columns:1fr 1fr;gap:3px;min-width:180px}.subjectCell select{width:100%;height:28px;padding:2px}.cellInput{width:100%;height:25px;text-align:center;padding:2px;font-size:10px}.ok{background:var(--greenbg)!important;border-color:var(--green)!important;color:#a5f1d0!important}.bad{background:var(--redbg)!important;border-color:var(--red)!important;color:#ffc0c5!important}.totals{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:9px}.totalbox,.stat{background:var(--field);border:1px solid var(--line);border-radius:9px;padding:10px}.totalbox span,.stat span{display:block;color:var(--muted);font-size:11px}.totalbox b,.stat b{display:block;font-size:16px;margin-top:3px;overflow-wrap:anywhere}.summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:9px}.stat{display:flex;justify-content:space-between;align-items:center;gap:6px}.verdict{margin-top:10px;padding:11px;border-radius:10px;text-align:center;font-weight:700;background:var(--field);border:1px solid var(--line)}.verdict.good{background:var(--greenbg);border-color:var(--green);color:#a5f1d0}.verdict.bad{background:var(--redbg);border-color:var(--red);color:#ffc0c5}.status{color:var(--muted);font-size:12px}@media(max-width:600px){header{padding-top:12px}.names{grid-template-columns:1fr 1fr}.totals{grid-template-columns:1fr 1fr}.summary{grid-template-columns:1fr}}
    </style></head><body>
    <header><h1>Controllo Consegne Smart</h1><p>Inserisci le consegne attese, assegna i nomi ai 10 collaboratori e importa i loro CSV: il gestionale abbina tutto per numero e segnala subito le anomalie.</p></header><main>
    <section class="panel"><div class="toolbar"><b>1. Consegne di riferimento (inserimento manuale)</b><div><button class="secondary" id="jump">Vai ai totali ↓</button><button class="secondary" id="clear">Azzera tutto</button><button id="save">Salva controllo</button></div></div><p class="hint">Inserisci ogni consegna attesa. Il collaboratore può averla in qualsiasi riga del CSV: il programma la cerca per numero/riferimento.</p><div class="toolbar"><button class="secondary" id="addRow">+ Aggiungi riga</button><button class="secondary" id="removeRow">− Togli ultima riga</button><span class="hint"><b id="rowCount">150</b> righe</span></div>
    <div class="tablewrap"><table><thead><tr><th>Riga</th><th>Numero<br>atteso</th><th>Totale<br>atteso €</th><th>Canale<br>atteso</th><th>Pagamento<br>atteso</th><th>Collaboratore<br>atteso</th><th class="subjectHead" data-colhead="0">Collaboratore 1</th><th class="subjectHead" data-colhead="1">Collaboratore 2</th><th class="subjectHead" data-colhead="2">Collaboratore 3</th><th class="subjectHead" data-colhead="3">Collaboratore 4</th><th class="subjectHead" data-colhead="4">Collaboratore 5</th><th class="subjectHead" data-colhead="5">Collaboratore 6</th><th class="subjectHead" data-colhead="6">Collaboratore 7</th><th class="subjectHead" data-colhead="7">Collaboratore 8</th><th class="subjectHead" data-colhead="8">Collaboratore 9</th><th class="subjectHead" data-colhead="9">Collaboratore 10</th></tr></thead><tbody id="grid"></tbody></table></div></section>
    <section class="panel"><b>2. Inserisci i nomi dei collaboratori</b><p class="hint">Scrivi i nomi esattamente come compaiono nelle schede. Quando importi un CSV, viene caricato automaticamente nella colonna del nome corrispondente.</p><div class="names" id="names"></div></section>
    <section class="panel"><div class="toolbar"><b>3. Carica i CSV</b><input id="files" type="file" accept=".csv,text/csv" multiple><button id="import">Importa CSV selezionati</button></div><p class="hint">Seleziona anche più CSV insieme. Ogni file viene riconosciuto dal nome collaboratore e caricato nella sua colonna. Se il nome o la data non coincidono, il gestionale te lo segnala.</p><div class="toolbar"><label>Data controllo <input id="day" type="date"></label><span id="status" class="status">Archivio locale pronto.</span></div></section>
    <section class="panel" id="summary"><b>4. Riepilogo e quadratura</b><div class="totals"><div class="totalbox"><span>Totale di riferimento</span><b id="refSum">0,00 €</b></div><div class="totalbox"><span>Totale consegne caricate</span><b id="loadedSum">0,00 €</b></div><div class="totalbox"><span>Differenza consegne</span><b id="diff">0,00 €</b></div></div><div class="summary"><div class="stat"><span>Consegne abbinate correttamente</span><b id="matched">0</b></div><div class="stat"><span>Consegne mancanti</span><b id="missing">0</b></div><div class="stat"><span>Duplicati / non previsti</span><b id="extras">0</b></div><div class="stat"><span>Totale Cash · marsupio</span><b id="cash">0,00 €</b></div><div class="stat"><span>Totale POS · separato</span><b id="pos">0,00 €</b></div><div class="stat"><span>Bonus F da riconoscere</span><b id="bonus">0,00 €</b></div></div><div class="summary" id="subjectSummary"></div><div id="verdict" class="verdict">Inserisci il riferimento e importa i CSV.</div></section>
    <section class="panel"><div class="toolbar"><b>5. Anomalie e controllo riga per riga</b><button class="secondary" id="export">Esporta controllo CSV</button><button class="secondary" id="restore">Ripristina ultimo salvataggio</button></div><div class="tablewrap"><table style="min-width:950px"><thead><tr><th>Numero</th><th>Collaboratore atteso</th><th>Collaboratore caricato</th><th>Importo atteso</th><th>Importo caricato</th><th>Canale</th><th>Pagamento</th><th>Esito</th></tr></thead><tbody id="audit"></tbody></table></div></section>
    </main><script>
    const $=id=>document.getElementById(id),S=10;let N=150,reference=[],people=Array.from({length:10},(_,i)=>'Collaboratore '+(i+1)),records={},timer;
    const fmt=n=>Number(n||0).toLocaleString('it-IT',{minimumFractionDigits:2,maximumFractionDigits:2})+' €';
    function money(v){let s=String(v??'').trim().replace(/[€\s]/g,'');if(!s)return null;if(s.includes(',')&&s.includes('.'))s=s.replace(/\./g,'').replace(',','.');else s=s.replace(',','.');let n=Number(s);return Number.isFinite(n)?Math.round(n*100)/100:NaN}
    function norm(v){return String(v??'').trim().replace(/^0+(?=\d)/,'').toLowerCase()}
    function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
    const defaultRef=()=>({num:'',amount:'',channel:'Telefono',payment:'Cash',person:''});
    function readRef(){let a=[];document.querySelectorAll('[data-refrow]').forEach((tr,i)=>a.push({num:tr.querySelector('[data-r=num]').value,amount:tr.querySelector('[data-r=amount]').value,channel:tr.querySelector('[data-r=channel]').value,payment:tr.querySelector('[data-r=payment]').value,person:tr.querySelector('[data-r=person]').value}));return a}
    function renderNames(){ document.querySelectorAll('[data-colhead]').forEach(h=>h.textContent=people[+h.dataset.colhead]||('Collaboratore '+(+h.dataset.colhead+1))); $('names').innerHTML=people.map((n,i)=>`<label class="namebox"><b>${i+1}.</b><input data-person="${i}" value="${esc(n)}" autocomplete="off" placeholder="Nome collaboratore ${i+1}"></label>`).join('');document.querySelectorAll('[data-person]').forEach(x=>x.addEventListener('input',()=>{people[+x.dataset.person]=x.value;paint();schedule()}))}
    function renderRows(){let refs=reference,occ=occurrences(),h='';for(let i=0;i<N;i++){let r=refs[i]||defaultRef(),hits=r.num.trim()?(occ.get(norm(r.num))||[]):[];h+=`<tr data-refrow="${i}"><td class="idx">${i+1}</td><td><input class="refInput" data-r="num" data-i="${i}" value="${esc(r.num)}" inputmode="numeric" pattern="[0-9]*" placeholder="N."></td><td><input class="refInput" data-r="amount" data-i="${i}" value="${esc(r.amount)}" inputmode="decimal" placeholder="€"></td><td><input class="refInput" data-r="channel" data-i="${i}" value="${esc(r.channel)}" placeholder="Telefono"></td><td><select class="refInput" data-r="payment" data-i="${i}"><option ${r.payment==='Cash'?'selected':''}>Cash</option><option ${r.payment==='POS'?'selected':''}>POS</option></select></td><td><input class="refInput" data-r="person" data-i="${i}" value="${esc(r.person)}" placeholder="Nome"></td>${Array.from({length:S},(_,j)=>{let x=hits.find(z=>z.pi===j);let dup=hits.length>1;let any=!!x;let ok=any&&!dup&&((money(r.amount)??NaN)===x.amount)&&(!r.channel||r.channel.trim().toLowerCase()===x.channel.trim().toLowerCase())&&r.payment===x.payment&&(!r.person||r.person.trim().toLowerCase()===x.person.trim().toLowerCase());let cl=any?(ok?'ok':'bad'):'';if(r.num.trim()&&!any)cl='bad';
    return `<td><div class="subjectCell"><input class="cellInput ${cl}" readonly value="${esc(x?.num||'')}" placeholder="${esc(people[j])} · N."><input class="cellInput ${cl}" readonly value="${x?fmt(x.amount):''}" placeholder="€"><input class="cellInput ${cl}" readonly value="${esc(x?.channel||'')}" placeholder="Canale"><input class="cellInput ${cl}" readonly value="${esc(x?.payment||'')}" placeholder="Cash/POS"><input class="cellInput" readonly value="${x?fmt(x.f):''}" placeholder="F"></div></td>`}).join('')}</tr>`} $('grid').innerHTML=h;$('rowCount').textContent=N;document.querySelectorAll('[data-r]').forEach(x=>x.addEventListener('input',()=>{reference=readRef();paint();schedule()}))}
    function parseCSV(text){let rows=[],row=[],f='',q=false;text=text.replace(/^\ufeff/,'');for(let i=0;i<text.length;i++){let c=text[i],n=text[i+1];if(q){if(c==='"'&&n==='"'){f+='"';i++}else if(c==='"')q=false;else f+=c}else if(c==='"')q=true;else if(c===';'||c===','){row.push(f);f=''}else if(c==='\n'){row.push(f);rows.push(row);row=[];f=''}else if(c!=='\r')f+=c}if(f.length||row.length){row.push(f);rows.push(row)}return rows.filter(r=>r.some(x=>String(x).trim()))}
    function find(rows,k){let r=rows.find(x=>String(x[0]||'').trim().toLowerCase()===k.toLowerCase());return r?String(r[1]||'').trim():''}
    async function importFile(file){let rows=parseCSV(await file.text()),day=find(rows,'Data'),person=find(rows,'Nome soggetto');if(day!==$('day').value)throw Error('Data del CSV ('+day+') diversa dalla data di controllo.');if(!person)throw Error('Nome collaboratore mancante.');let pi=people.findIndex(x=>x.trim().toLowerCase()===person.trim().toLowerCase());if(pi<0)throw Error('Il nome "'+person+'" non corrisponde a nessuno dei 10 collaboratori impostati.');let head=rows.findIndex(r=>String(r[0]||'').trim().toLowerCase()==='riferimento');if(head<0)throw Error('Formato CSV non riconosciuto.');if(records[pi]&&records[pi].day===day&&!confirm('Esiste già un CSV caricato per '+person+'. Vuoi sostituirlo?'))throw Error('Importazione annullata: esiste già un file per questo collaboratore.');let entries=[];for(let i=head+1;i<rows.length;i++){let r=rows[i];if(!r.some(x=>String(x).trim()))continue;let ref=String(r[0]||'').trim();if(!ref){if(!r.slice(1).some(x=>String(x).trim()))continue;throw Error('Riga '+(i+1)+': dati presenti ma riferimento mancante.');}let pay=String(r[2]||'').trim();if(!['cash','pos'].includes(pay.toLowerCase()))throw Error('Riga '+(i+1)+': pagamento deve essere Cash o POS.');let amount=money(r[3]);if(amount===null||Number.isNaN(amount)||amount<0)throw Error('Riga '+(i+1)+': importo non valido.');let f=money(r[4]||'0');if(f===null||Number.isNaN(f)||f<0)throw Error('Riga '+(i+1)+': bonus F non valido.');entries.push({num:ref,amount,channel:String(r[1]||'').trim(),payment:pay.toLowerCase()==='pos'?'POS':'Cash',f})}
    if(!entries.length)throw Error('Nessuna consegna trovata nel CSV.');records[pi]={day,person,entries};return person+': '+entries.length+' consegne importate'}
    function occurrences(){let map=new Map();Object.entries(records).forEach(([pi,rec])=>(rec.entries||[]).forEach(e=>{let k=norm(e.num);if(!map.has(k))map.set(k,[]);map.get(k).push({...e,person:rec.person,pi:+pi})}));return map}
    function paint(){reference=readRef();let occ=occurrences(),expected=reference.filter(x=>x.num.trim()),refSum=0,loadedSum=0,cash=0,pos=0,bonus=0,matched=0,missing=0,extras=0,results=[],per=Array(S).fill(0).map(()=>({sum:0,cash:0,pos:0,f:0,count:0}));
    expected.forEach(r=>{let a=money(r.amount);if(a!==null&&!Number.isNaN(a))refSum+=a;let hits=occ.get(norm(r.num))||[],problems=[];if(!hits.length){missing++;problems.push('Mancante')}else if(hits.length>1){extras+=hits.length;problems.push('Duplicato')}else{let x=hits[0];if(r.person&&r.person.trim().toLowerCase()!==x.person.trim().toLowerCase())problems.push('Collaboratore diverso');if(r.channel&&r.channel.trim().toLowerCase()!==x.channel.trim().toLowerCase())problems.push('Canale diverso');if(r.payment!==x.payment)problems.push('Pagamento diverso');if(a===null||Number.isNaN(a)||a!==x.amount)problems.push('Importo diverso');if(!problems.length)matched++}let x=hits.length===1?hits[0]:null;results.push({r,x,ok:problems.length===0&&!!x,status:problems.join(', ')||'OK'});});
    let expKeys=new Set(expected.map(x=>norm(x.num)));occ.forEach((hits,k)=>{if(!expKeys.has(k)){extras+=hits.length;hits.forEach(x=>results.push({r:null,x,ok:false,status:'Non previsto'}))}});
    Object.entries(records).forEach(([pi,rec])=>(rec.entries||[]).forEach(e=>{let p=per[+pi];p.sum+=e.amount;p.count++;p.f+=e.f;if(e.payment==='POS')p.pos+=e.amount;else p.cash+=e.amount;loadedSum+=e.amount;bonus+=e.f;if(e.payment==='POS')pos+=e.amount;else cash+=e.amount}));
    $('refSum').textContent=fmt(refSum);$('loadedSum').textContent=fmt(loadedSum);$('diff').textContent=fmt(loadedSum-refSum);$('matched').textContent=matched;$('missing').textContent=missing;$('extras').textContent=extras;$('cash').textContent=fmt(cash);$('pos').textContent=fmt(pos);$('bonus').textContent=fmt(bonus);
    $('subjectSummary').innerHTML=people.map((n,i)=>`<div class="stat"><span>${esc(n||'Collaboratore '+(i+1))} · ${per[i].count} consegne · Cash ${fmt(per[i].cash)} · POS ${fmt(per[i].pos)} · F ${fmt(per[i].f)}</span><b>${fmt(per[i].sum+per[i].f)}</b></div>`).join('');
    $('audit').innerHTML=results.map(z=>`<tr><td class="${z.ok?'ok':'bad'}">${esc(z.r?.num||z.x?.num)}</td><td class="${z.ok?'ok':'bad'}">${esc(z.r?.person||'—')}</td><td class="${z.ok?'ok':'bad'}">${esc(z.x?.person||'—')}</td><td class="${z.ok?'ok':'bad'}">${z.r?fmt(money(z.r.amount)||0):'—'}</td><td class="${z.ok?'ok':'bad'}">${z.x?fmt(z.x.amount):'—'}</td><td class="${z.ok?'ok':'bad'}">${esc(z.x?.channel||z.r?.channel||'—')}</td><td class="${z.ok?'ok':'bad'}">${esc(z.x?.payment||z.r?.payment||'—')}</td><td class="${z.ok?'ok':'bad'}">${esc(z.status)}</td></tr>`).join('')||'<tr><td colspan="8">Nessun dato da controllare</td></tr>';
    let allExpected=expected.length>0&&missing===0&&extras===0&&matched===expected.length&&Math.abs(loadedSum-refSum)<0.005;let v=$('verdict');v.className='verdict '+(allExpected?'good':'bad');v.textContent=allExpected?'TUTTO OK: consegne, collaboratori, canali, pagamenti e importi corrispondono.':'ANOMALIE: verifica consegne mancanti, duplicate, non previste o con importi/canali/pagamenti/collaboratori diversi.'}
    function storageKey(){return 'deliveryControlSmartV5|'+$('day').value}
    function snapshot(){return{day:$('day').value,N,reference:readRef(),people,records}}
    function schedule(){clearTimeout(timer);timer=setTimeout(()=>{try{localStorage.setItem(storageKey(),JSON.stringify(snapshot()));$('status').textContent='Salvataggio automatico locale attivo.'}catch(e){}},300)}
    function openDB(){return new Promise((ok,no)=>{let q=indexedDB.open('DeliveryControlSmartV5DB',1);q.onupgradeneeded=()=>q.result.createObjectStore('saved',{keyPath:'id',autoIncrement:true});q.onsuccess=()=>ok(q.result);q.onerror=()=>no(q.error)})}
    $('save').onclick=async()=>{let x=snapshot();localStorage.setItem(storageKey(),JSON.stringify(x));let db=await openDB();await new Promise((ok,no)=>{let tx=db.transaction('saved','readwrite');tx.objectStore('saved').add(x);tx.oncomplete=ok;tx.onerror=()=>no(tx.error)});$('status').textContent='Salvato in IndexedDB e LocalStorage.'};
    $('restore').onclick=()=>{let x;try{x=JSON.parse(localStorage.getItem(storageKey())||'null')}catch(e){}if(!x)return alert('Nessun salvataggio trovato.');N=x.N||150;reference=x.reference||[];people=x.people||people;records=x.records||{};renderNames();renderRows();paint();$('status').textContent='Ultimo controllo ripristinato.'};
    $('addRow').onclick=()=>{if(N>=500)return alert('Massimo 500 righe.');reference=readRef();reference.push(defaultRef());N++;renderRows();paint();schedule()};
    $('removeRow').onclick=()=>{if(N<=1)return;reference=readRef();let last=reference.pop();if(Object.values(last).some(v=>String(v).trim())&&!confirm('L’ultima riga contiene dati. Eliminarla?')){reference.push(last);return}N--;renderRows();paint();schedule()};
    $('clear').onclick=()=>{if(confirm('Azzero riferimento e caricamenti della data selezionata?')){reference=Array.from({length:N},defaultRef);records={};renderRows();paint();schedule()}};
    $('jump').onclick=()=>$('summary').scrollIntoView({behavior:'smooth'});
    $('import').onclick=async()=>{let fs=[...$('files').files];if(!fs.length)return alert('Seleziona i CSV.');let out=[],err=[];for(let f of fs){try{out.push(await importFile(f))}catch(e){err.push(f.name+': '+e.message)}}$('files').value='';renderRows();$('status').textContent=out.join(' · ')+(err.length?' · ERRORI: '+err.join(' | '):' · Importazione verificata');if(err.length)alert('File non importati:\\n'+err.join('\\n'));paint();schedule()};
    $('export').onclick=()=>{let rows=[['Numero atteso','Importo atteso','Canale atteso','Pagamento atteso','Collaboratore atteso','Numero caricato','Importo caricato','Canale caricato','Pagamento caricato','F','Esito'],...reference.filter(x=>x.num).map(r=>{let x=(occurrences().get(norm(r.num))||[])[0];return[r.num,r.amount,r.channel,r.payment,r.person,x?.num||'',x?.amount??'',x?.channel||'',x?.payment||'',x?.f??'',x?'Caricato':'Mancante']})];let csv='\ufeff'+rows.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(';')).join('\r\n'),a=document.createElement('a'),u=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.href=u;a.download='controllo-consegne-'+$('day').value+'.csv';a.click();URL.revokeObjectURL(u)};
    $('day').value=new Date().toISOString().slice(0,10);$('day').addEventListener('change',()=>{let x=null;try{x=JSON.parse(localStorage.getItem(storageKey())||'null')}catch(e){};N=x?.N||150;reference=x?.reference||[];people=x?.people||Array.from({length:10},(_,i)=>'Collaboratore '+(i+1));records=x?.records||{};renderNames();renderRows();paint();$('status').textContent='Controllo caricato per la data selezionata.'});

    (function init(){let x;try{x=JSON.parse(localStorage.getItem(storageKey())||'null')}catch(e){}if(x&&x.day===$('day').value){N=x.N||150;reference=x.reference||[];people=x.people||people;records=x.records||{}}renderNames();renderRows();paint()})();
    </script></body></html>
